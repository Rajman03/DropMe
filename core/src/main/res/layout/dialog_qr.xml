<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:padding="20dp">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <FrameLayout
            android:id="@+id/btnDialogClose"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/circle_action_btn_light"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"
                android:contentDescription="Zamknij" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Szczegóły Kodu QR"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center" />

        <View
            android:layout_width="38dp"
            android:layout_height="38dp" />
    </LinearLayout>

    <!-- Main QR Hero Preview Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_featured_bg"
        android:padding="16dp"
        android:gravity="center_horizontal"
        android:elevation="4dp"
        android:layout_marginBottom="16dp">

        <FrameLayout
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:background="@drawable/card_qr_white_bg"
            android:padding="12dp"
            android:layout_marginVertical="8dp">

            <ImageView
                android:id="@+id/ivQrCodeImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="Kod QR" />

            <ProgressBar
                android:id="@+id/pbQrLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/primary" />
        </FrameLayout>

        <!-- Floating Glassmorphic Capsule inside card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_overlay_pill"
            android:padding="12dp"
            android:layout_marginTop="8dp">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/circle_icon_white_bg"
                android:layout_marginEnd="10dp">

                <ImageView
                    android:id="@+id/ivDialogPlatformIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_globe"
                    android:contentDescription="Logo platformy" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDialogPlatformTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instagram"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/tvDialogUrl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="https://instagram.com/twoj_profil"
                    android:textSize="11sp"
                    android:textColor="#BFDBFE"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HD QR"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FDE68A"
                android:background="@drawable/circle_action_btn"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Info Pills Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/badge_status_info"
            android:layout_marginEnd="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zawsze aktywny"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/badge_status_info"
            android:layout_marginEnd="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Szybki skan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/badge_status_ok"
            android:paddingHorizontal="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: OK"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/income_green" />
        </LinearLayout>
    </LinearLayout>

    <!-- Description Paragraph -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ten kod QR umożliwia natychmiastowe otwarcie profilu aparatem każdego telefonu, bez konieczności ręcznego wpisywania adresu."
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginBottom="18dp" />

    <!-- Bottom Actions -->
    <Button
        android:id="@+id/btnDialogOpenLink"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Otwórz profil w przeglądarce"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/btn_pill_dark"
        android:textColor="@color/white"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnDialogCopyLink"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="Kopiuj link do profilu"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:background="@drawable/btn_pill_light" />

</LinearLayout>
