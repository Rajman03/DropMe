<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tvPinIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/circle_action_btn_light"
        android:gravity="center"
        android:text="🔐"
        android:textSize="24sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvPinTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Weryfikacja PIN (2FA)"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvPinHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wpisz 4-cyfrowy kod PIN administratora"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginBottom="18dp" />

    <EditText
        android:id="@+id/etPinInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="••••"
        android:inputType="numberPassword"
        android:maxLength="8"
        android:textSize="24sp"
        android:gravity="center"
        android:letterSpacing="0.25"
        android:background="@drawable/search_bar_bg"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="18dp" />

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btnConfirmPin"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="Zatwierdź PIN"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@drawable/btn_pill_dark"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnCancelPin"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:text="Anuluj"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:background="@drawable/btn_pill_light" />

</LinearLayout>
