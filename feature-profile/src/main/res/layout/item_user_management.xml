<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:padding="14dp"
    android:layout_marginBottom="12dp"
    android:elevation="2dp">

    <!-- Top info row: Avatar, Name, Username, Rank Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvUserItemAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/circle_action_btn_light"
            android:gravity="center"
            android:text="👤"
            android:textSize="22sp"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvUserItemDisplayName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jan Kowalski"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvUserItemUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@jankowalski"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvUserItemRankBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guest"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/badge_guest"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <!-- Badges Row: Purchased tag / Cloud sync status -->
    <LinearLayout
        android:id="@+id/layoutUserItemTags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvUserItemPurchasedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💳 Zakup własny w Paywall"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#047857"
            android:background="@drawable/badge_status_ok_light"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:visibility="gone"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvUserItemNotice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Użytkownik standardowy"
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EDF2F7"
        android:layout_marginVertical="10dp" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:id="@+id/layoutUserActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <!-- Admin toggle (Creator only) -->
        <Button
            android:id="@+id/btnUserItemToggleAdmin"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Nadaj Admina"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/badge_admin"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <!-- Change Admin PIN (Creator only) -->
        <Button
            android:id="@+id/btnUserItemChangePin"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Zmień PIN"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_pill_light"
            android:paddingHorizontal="10dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <!-- Premium toggle -->
        <Button
            android:id="@+id/btnUserItemTogglePremium"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Nadaj Premium"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/btn_pill_dark"
            android:paddingHorizontal="12dp"
            android:visibility="visible" />

        <!-- Locked notice (if purchased) -->
        <TextView
            android:id="@+id/tvUserItemLockedNotice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zakupiono w Paywall (Ochrona)"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:background="@drawable/badge_status_info"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:visibility="gone" />

        <!-- Delete user from Supabase (Creator only) -->
        <Button
            android:id="@+id/btnUserItemDelete"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Usuń"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/expense_red"
            android:background="@drawable/badge_expense"
            android:paddingHorizontal="12dp"
            android:layout_marginStart="8dp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
