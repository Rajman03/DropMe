<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutProfile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    android:scrollbars="none"
    android:clipToPadding="false"
    android:paddingTop="10dp"
    android:paddingBottom="24dp"
    android:paddingHorizontal="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. HERO IDENTITY CARD (Kompaktowa karta profilu) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:elevation="2dp">

            <!-- Top Bar: Cloud sync status + Sync button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvProfileSyncStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Konto zsynchronizowane"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#059669" />

                <Button
                    android:id="@+id/btnProfileSyncCloud"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:minHeight="0dp"
                    android:text="Synchronizuj"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_pill_light"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="10dp" />
            </LinearLayout>

            <!-- User Info: Avatar on left, details on right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <!-- Avatar with Role Ring -->
                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="14dp">

                    <View
                        android:id="@+id/ivProfileAvatarRing"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/avatar_ring_guest" />

                    <TextView
                        android:id="@+id/tvProfileAvatarLarge"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:gravity="center"
                        android:text="👤"
                        android:textSize="26sp" />
                </FrameLayout>

                <!-- User Details Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProfileDisplayName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Użytkownik"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvProfileHandle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@uzytkownik"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="1dp" />

                    <TextView
                        android:id="@+id/tvProfileRankBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Twórca"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@drawable/badge_owner"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:layout_marginTop="5dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Quick Stats Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/stat_pill_bg"
                android:paddingVertical="8dp"
                android:paddingHorizontal="4dp"
                android:gravity="center">

                <!-- Stat 1: QR count -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvStatQrCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kody QR"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="1dp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:background="#E2E8F0" />

                <!-- Stat 2: Limit -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvStatQrLimit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bez limitu"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#059669" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Limit konta"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="1dp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:background="#E2E8F0" />

                <!-- Stat 3: Plan/Rank -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvStatRank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aktywne"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pakiet"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="1dp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- 2. MANAGEMENT PANEL CARD (Tylko dla Creator / Admin) -->
        <LinearLayout
            android:id="@+id/cardUserManagement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:elevation="2dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tvManagementHeaderTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"                        android:text="Zarządzanie Użytkownikami"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvManagementBadgeHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Centrum Administracji"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/badge_status_ok"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvManagementDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Podgląd i zarządzanie kontami w aplikacji."
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnOpenUserManagement"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Zarządzaj"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/btn_pill_dark"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnChangeAdminPin"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Zmień PIN"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/btn_pill_light"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- 3. ACCOUNT & ACTIONS CARD (Konto, Polityka i Wylogowanie) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:elevation="2dp">

            <!-- Informacje o koncie w jednym zwięzłym wierszu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Konto: "
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvAccountUsername"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@uzytkownik"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvAccountCloudStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zsynchronizowano"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#059669" />
            </LinearLayout>

            <!-- Przyciski akcji: Polityka prywatności oraz Wyloguj -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnProfilePrivacyPolicy"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Polityka RODO"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/btn_pill_light"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnLogOut"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Wyloguj się"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/expense_red"
                    android:background="@drawable/btn_logout_pill" />
            </LinearLayout>

            <Button
                android:id="@+id/btnChangePassword"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:text="Zmień hasło"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@drawable/btn_pill_light" />

            <Button
                android:id="@+id/btnChangeEmail"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:text="Zmień e-mail"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@drawable/btn_pill_light" />

            <Button
                android:id="@+id/btnDeleteAccount"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:text="Usuń konto"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#ef4444"
                android:background="@drawable/btn_pill_light" />

        </LinearLayout>

        <!-- Karta polityki (zachowana niewidoczna dla kompatybilności ID) -->
        <LinearLayout
            android:id="@+id/cardPrivacyPolicy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
