<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutProfile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    android:scrollbars="none"
    android:clipToPadding="false"
    android:paddingTop="12dp"
    android:paddingBottom="130dp"
    android:paddingHorizontal="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. HERO IDENTITY CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:elevation="3dp">

            <!-- Top Bar inside Hero Card (Cloud sync status + Sync button) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvProfileSyncStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🟢 Konto zsynchronizowane"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#059669" />

                <Button
                    android:id="@+id/btnProfileSyncCloud"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minHeight="0dp"
                    android:text="🔄 Synchronizuj"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_pill_light"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="12dp" />
            </LinearLayout>

            <!-- Avatar with Role Ring Frame -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <View
                    android:id="@+id/ivProfileAvatarRing"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/avatar_ring_guest" />

                <TextView
                    android:id="@+id/tvProfileAvatarLarge"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:gravity="center"
                    android:text="👤"
                    android:textSize="40sp" />
            </FrameLayout>

            <!-- User Display Name -->
            <TextView
                android:id="@+id/tvProfileDisplayName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Użytkownik"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center" />

            <!-- User Handle / Username -->
            <TextView
                android:id="@+id/tvProfileHandle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@uzytkownik"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp"
                android:gravity="center" />

            <!-- Rank Badge -->
            <TextView
                android:id="@+id/tvProfileRankBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Użytkownik"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/badge_status_ok"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:layout_marginTop="8dp" />

            <!-- Quick Stats Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/stat_pill_bg"
                android:paddingVertical="12dp"
                android:paddingHorizontal="4dp"
                android:layout_marginTop="18dp"
                android:gravity="center">

                <!-- Stat 1: QR codes count -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvStatQrCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kody QR"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:background="#E2E8F0" />

                <!-- Stat 2: Limit -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvStatQrLimit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bez limitu"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#059669" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Limit konta"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:background="#E2E8F0" />

                <!-- Stat 3: Plan/Rank -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvStatRank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Użytkownik"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pakiet"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- 2. MANAGEMENT PANEL CARD (Only for Creator / Admin) -->
        <LinearLayout
            android:id="@+id/cardUserManagement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:elevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvManagementHeaderTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="👑 Panel Zarządzania"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvManagementBadgeHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Centrum Administracji"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/badge_status_ok"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvManagementDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zarządzaj kontami użytkowników, poziomami dostępu oraz konfiguracją kodów PIN."
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnOpenUserManagement"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="👑 Otwórz Panel Zarządzania (Creator)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/btn_pill_dark" />

        </LinearLayout>

        <!-- 3. ACCOUNT & SESSION CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:elevation="2dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 Konto i Bezpieczeństwo"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤"
                    android:textSize="16sp"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Zalogowany użytkownik"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvAccountUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@uzytkownik"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F5F9"
                android:layout_marginVertical="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☁️"
                    android:textSize="16sp"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Kopia zapasowa konta"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvAccountCloudStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zsynchronizowano"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#059669" />
            </LinearLayout>

            <!-- Logout Button -->
            <Button
                android:id="@+id/btnLogOut"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="  Wyloguj się z konta"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/expense_red"
                android:drawableStart="@drawable/ic_logout"
                android:drawablePadding="10dp"
                android:gravity="center"
                android:background="@drawable/btn_logout_pill"
                android:layout_marginTop="14dp" />
        </LinearLayout>

        <!-- 4. PRIVACY & DATA PROTECTION CARD -->
        <LinearLayout
            android:id="@+id/cardPrivacyPolicy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:elevation="2dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🛡️ Prywatność i Dane"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RODO / GDPR"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/badge_status_ok"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DropMe nie śledzi użytkowników, nie używa zewnętrznych trackerów ani reklam. Twoje dane są bezpiecznie przechowywane lokalnie na urządzeniu."
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnProfilePrivacyPolicy"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="📄 Zobacz Politykę Prywatności i Dane"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@drawable/btn_pill_light" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
