<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="20dp">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zarządzanie Użytkownikami"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvManagementOperatorRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👑 Zalogowano: Creator"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseManagementDialog"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_close"
            android:background="@drawable/circle_action_btn_light"
            android:contentDescription="Zamknij" />
    </LinearLayout>

    <!-- Permissions Banner -->
    <LinearLayout
        android:id="@+id/bannerPermissionsNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:elevation="1dp">

        <TextView
            android:id="@+id/tvPermissionsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Uprawnienia Twojej Roli"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvPermissionsDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jako Creator możesz nadawać i odbierać rangi Admin oraz Premium (zabezpieczenie blokuje usunięcie rang kupionych w Paywall)."
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <!-- Supabase Status & Refresh Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/card_bg"
        android:padding="10dp"
        android:layout_marginBottom="12dp"
        android:elevation="1dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡"
            android:textSize="16sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvSupabaseSyncStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Supabase: Chmura połączona"
            android:textSize="12sp"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnRefreshFromSupabase"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="🔄 Odśwież"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_pill_light"
            android:paddingHorizontal="12dp" />
    </LinearLayout>

    <!-- Search bar for users -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/search_bar_bg"
        android:paddingHorizontal="14dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="14sp"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/etSearchUserManagement"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Filtruj użytkowników po nazwie..."
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="12sp"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Users List ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/containerUserManagementItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Dynamic items will be added here -->

        </LinearLayout>
    </ScrollView>

    <!-- Footer button -->
    <Button
        android:id="@+id/btnBottomCloseManagement"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="Zamknij Panel"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@drawable/btn_pill_dark"
        android:layout_marginTop="8dp" />

</LinearLayout>
