<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tvLogoutIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/circle_icon_red"
        android:gravity="center"
        android:text="🚪"
        android:textSize="26sp"
        android:layout_marginBottom="14dp" />

    <TextView
        android:id="@+id/tvLogoutTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wylogowanie z konta"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvLogoutMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Czy na pewno chcesz się wylogować?\nTwoja aktywna sesja zostanie bezpiecznie zakończona."
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginBottom="22dp" />

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btnConfirmLogout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Wyloguj się"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@drawable/btn_pill_red"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnCancelLogout"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Anuluj (Pozostań zalogowany)"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:background="@drawable/btn_pill_light" />

</LinearLayout>
