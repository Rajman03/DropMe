<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:padding="24dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tvChangePasswordTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Zmień hasło"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvChangePasswordSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Użytkownik: @user"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="18dp" />

    <!-- Current password -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aktualne hasło"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etCurrentPassword"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:hint="Wpisz aktualne hasło"
        android:inputType="textPassword"
        android:textSize="14sp"
        android:background="@drawable/search_bar_bg"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="14dp" />

    <!-- New password -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nowe hasło (min. 6 znaków)"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etNewPassword"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:hint="Wpisz nowe hasło"
        android:inputType="textPassword"
        android:textSize="14sp"
        android:background="@drawable/search_bar_bg"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="14dp" />

    <!-- Confirm password -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Powtórz nowe hasło"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etConfirmPassword"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:hint="Powtórz nowe hasło"
        android:inputType="textPassword"
        android:textSize="14sp"
        android:background="@drawable/search_bar_bg"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="6dp" />

    <!-- Inline validation / progress message -->
    <TextView
        android:id="@+id/tvPasswordMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/expense_red"
        android:visibility="gone"
        android:layout_marginBottom="6dp" />

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btnSubmitChangePassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Zmień hasło"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@drawable/btn_pill_dark"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnCancelChangePassword"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Anuluj"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:background="@drawable/btn_pill_light" />

</LinearLayout>
