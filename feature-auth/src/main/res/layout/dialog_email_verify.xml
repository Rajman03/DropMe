<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Top Icon Badge -->
    <TextView
        android:id="@+id/tvVerifyIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/circle_icon_blue"
        android:gravity="center"
        android:text="✉️"
        android:textSize="26sp"
        android:layout_marginBottom="12dp" />

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/tvVerifyTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Potwierdź adres e-mail"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:layout_marginBottom="6dp" />

    <!-- Subtitle instruction -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wysłaliśmy 6-cyfrowy kod weryfikacyjny na adres:"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:gravity="center" />

    <!-- Target Email Highlight -->
    <TextView
        android:id="@+id/tvVerifyEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="twoj@email.com"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/accent"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp" />

    <!-- Code Input Box -->
    <EditText
        android:id="@+id/etVerifyCode"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="• • • • • •"
        android:textColorHint="#94A3B8"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold"
        android:letterSpacing="0.25"
        android:gravity="center"
        android:background="@drawable/code_input_bg"
        android:inputType="number"
        android:maxLength="6"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="8dp" />

    <!-- Info / Timer / Attempts indicator -->
    <TextView
        android:id="@+id/tvVerifyInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏱️ Kod jest ważny przez 10 minut"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btnConfirmVerify"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Potwierdź i utwórz konto"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@drawable/btn_pill_dark"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnCancelVerify"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Wróć do edycji"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:background="@drawable/btn_pill_light" />

</LinearLayout>
