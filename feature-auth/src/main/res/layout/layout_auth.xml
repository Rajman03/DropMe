<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutAuth"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:visibility="gone"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Logo & Brand Header -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:layout_marginTop="24dp">

            <FrameLayout
                android:id="@+id/btnAuthLogoSecret"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/card_featured_bg"
                android:elevation="4dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_dropme_logo"
                    android:contentDescription="DropMe Logo" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DropMe"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Twoja cyfrowa wizytówka i kody QR w 1 miejscu"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Card with Login/Register Tabs and Forms -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="22dp"
            android:elevation="3dp">

            <!-- Mode Toggle Tabs (Logowanie / Rejestracja) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:background="@drawable/btn_pill_light"
                android:padding="4dp"
                android:layout_marginBottom="20dp">

                <Button
                    android:id="@+id/tabAuthLogin"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Logowanie"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_pill_dark"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/tabAuthRegister"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Rejestracja"
                    android:textSize="13sp"
                    android:background="@android:color/transparent"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Name field (only visible in Register mode) -->
            <LinearLayout
                android:id="@+id/groupAuthName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Imię i nazwisko"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etAuthName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="np. Jan Kowalski"
                    android:inputType="textCapWords"
                    android:background="@drawable/search_bar_bg"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Login / Email field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Login"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etAuthLogin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Wpisz login (np. creator)"
                android:inputType="text"
                android:background="@drawable/search_bar_bg"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <!-- Password field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hasło"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etAuthPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="••••••••"
                android:inputType="textPassword"
                android:background="@drawable/search_bar_bg"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <!-- Submit Button -->
            <Button
                android:id="@+id/btnAuthSubmit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Zaloguj się"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/btn_pill_dark"
                android:textColor="@color/white"
                android:layout_marginTop="4dp" />

            <!-- Privacy Policy Link -->
            <TextView
                android:id="@+id/tvAuthPrivacyPolicy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="🛡️ Polityka prywatności i ochrona danych"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:padding="6dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
