<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/circle_icon_blue"
        android:gravity="center"
        android:text="🔒"
        android:textSize="26sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ustaw nowe hasło"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvResetEmailInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wpisz 6-cyfrowy kod z e-maila oraz nowe hasło:"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etResetCode"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Kod z e-maila (6 cyfr)"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:gravity="center"
        android:background="@drawable/search_bar_bg"
        android:inputType="number"
        android:maxLength="6"
        android:paddingHorizontal="14dp"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/etResetNewPass"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Nowe hasło (min. 6 znaków)"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:background="@drawable/search_bar_bg"
        android:inputType="textPassword"
        android:paddingHorizontal="14dp"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/etResetConfirmPass"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Powtórz nowe hasło"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:background="@drawable/search_bar_bg"
        android:inputType="textPassword"
        android:paddingHorizontal="14dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnSubmitResetPassword"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Zmień hasło i zaloguj"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@drawable/btn_pill_dark"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnCancelResetPassword"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Anuluj"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:background="@drawable/btn_pill_light" />

</LinearLayout>
