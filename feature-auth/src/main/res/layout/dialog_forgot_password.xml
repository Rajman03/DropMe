<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/circle_icon_blue"
        android:gravity="center"
        android:text="🔑"
        android:textSize="26sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Zapomniałeś hasła?"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wpisz adres e-mail powiązany z Twoim kontem DropMe. Wyślemy na niego 6-cyfrowy kod do zresetowania hasła."
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etForgotEmail"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="np. twoj@email.com"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:background="@drawable/search_bar_bg"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="14dp"
        android:layout_marginBottom="18dp" />

    <Button
        android:id="@+id/btnSubmitForgotEmail"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Wyślij kod weryfikacyjny"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@drawable/btn_pill_dark"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnCancelForgotEmail"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Wróć do logowania"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:background="@drawable/btn_pill_light" />

</LinearLayout>
