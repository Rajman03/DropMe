<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="256dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="8dp">

    <!-- Unified Pass Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/qr_pass_card_bg"
        android:padding="16dp"
        android:elevation="6dp">

        <!-- Top Header: Platform Badge + Heart & Trash Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Brand Icon & Tag -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/badge_card_platform"
                android:paddingStart="4dp"
                android:paddingEnd="12dp">

                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/circle_icon_white_bg">

                    <ImageView
                        android:id="@+id/ivCardPlatformIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_instagram"
                        android:contentDescription="Logo platformy" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvCardPlatformTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instagram"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Favorite Heart Button -->
            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/circle_action_btn"
                android:layout_marginEnd="6dp">

                <ImageView
                    android:id="@+id/btnCardHeart"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_heart_outline"
                    android:contentDescription="Ulubione" />
            </FrameLayout>

            <!-- Delete Trash Button -->
            <FrameLayout
                android:id="@+id/btnCardDelete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/circle_action_btn_danger">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_trash"
                    android:contentDescription="Usuń kod QR" />
            </FrameLayout>
        </LinearLayout>

        <!-- Center: QR Code Display Frame -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="156dp"
            android:gravity="center">

            <FrameLayout
                android:layout_width="136dp"
                android:layout_height="136dp"
                android:layout_gravity="center"
                android:background="@drawable/card_qr_white_bg"
                android:padding="6dp"
                android:elevation="3dp">

                <ImageView
                    android:id="@+id/ivCardQrPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="Kod QR" />

                <ProgressBar
                    android:id="@+id/pbCardQrLoading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/primary" />
            </FrameLayout>
        </FrameLayout>

        <!-- Bottom Detail Pill -->
        <LinearLayout
            android:id="@+id/btnCardOpenDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_overlay_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvCardName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Instagram"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvCardUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="instagram.com/profil"
                android:textSize="11sp"
                android:textColor="#94A3B8"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Show Fullscreen Button -->
        <Button
            android:id="@+id/btnCardShowBig"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Powiększ Kod QR 📱"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/btn_card_action"
            android:textColor="#0F172A" />

    </LinearLayout>

</LinearLayout>
