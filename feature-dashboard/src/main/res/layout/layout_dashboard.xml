<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="visible"
    android:scrollbars="none"
    android:clipToPadding="false"
    android:paddingTop="14dp"
    android:paddingBottom="130dp"
    android:paddingHorizontal="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/search_bar_bg"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="15sp"
                android:layout_marginEnd="10dp" />

            <EditText
                android:id="@+id/etSearchQr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Szukaj profilu, platformy lub linku..."
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- FEATURED: Multi-Link Profile Card -->
        <LinearLayout
            android:id="@+id/cardMultiLinkFeatured"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_featured_bg"
            android:padding="18dp"
            android:elevation="4dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🌟 Moja Wizytówka Multi-Link"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WSZYSTKO W 1"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/badge_discount"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMultiLinkSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wszystkie Twoje profile (Instagram, TikTok, Snapchat, Discord) w jednym kodzie QR!"
                android:textSize="12sp"
                android:textColor="#E2E8F0"
                android:layout_marginBottom="12dp" />

            <!-- Multi-Link Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnShowMultiLinkQr"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="📱 Pokaż Kod QR"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:background="@drawable/btn_pill_light"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnEditMultiLink"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="✏️ Edytuj Linki"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_pill_dark"
                    android:paddingHorizontal="14dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quick QR Scanner Launch Button -->
        <LinearLayout
            android:id="@+id/btnQuickScannerLaunch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/btn_pill_light"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_nav_scan"
                android:contentDescription="Skanuj" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷 Zeskanuj Kod QR Znajomego"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Section Header: Moje kody QR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Moje kody QR"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvQrCounterBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 kody"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:background="@drawable/badge_status_info"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp" />
        </LinearLayout>

        <!-- Category Filter Chips Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/chipFilterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Wszystkie"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_pill_dark"
                    android:textColor="@color/white"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/chipFilterSocial"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Social Media"
                    android:textSize="12sp"
                    android:background="@drawable/btn_pill_light"
                    android:textColor="@color/text_secondary"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/chipFilterBiz"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Biznes"
                    android:textSize="12sp"
                    android:background="@drawable/btn_pill_light"
                    android:textColor="@color/text_secondary"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/chipFilterFav"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Ulubione"
                    android:textSize="12sp"
                    android:background="@drawable/btn_pill_light"
                    android:textColor="@color/text_secondary"
                    android:paddingHorizontal="16dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- HORIZONTAL CAROUSEL OF QR CARDS -->
        <HorizontalScrollView
            android:id="@+id/scrollQrCarousel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/userQrContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Empty state container -->
        <LinearLayout
            android:id="@+id/tvEmptyQrList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="24dp"
            android:gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            android:elevation="1dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_action_btn_light"
                android:gravity="center"
                android:text="QR"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Brak kodów QR"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dodaj swój pierwszy profil korzystając z formularza poniżej."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Guest Limit Banner -->
        <LinearLayout
            android:id="@+id/bannerLimitReached"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/paywall_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Limit konta Guest (maksymalnie 3 kody)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FDE68A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Przejdź na Premium, aby tworzyć nielimitowaną liczbę kodów oraz korzystać z własnych kolorów."
                android:textSize="12sp"
                android:textColor="@color/white"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btnBannerGoPaywall"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Odblokuj pakiet Premium"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/btn_gold"
                android:textColor="@color/white"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- FAB-STYLE ADD QR BUTTON -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp">

            <FrameLayout
                android:id="@+id/fabAddQr"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/fab_add_bg"
                android:elevation="6dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="+"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />
            </FrameLayout>
        </LinearLayout>

        <!-- Formularz tworzenia nowego kodu QR (rozwijany przyciskiem +) -->
        <LinearLayout
            android:id="@+id/formAddQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <!-- Platform Selector Row (horizontally scrollable) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                    <!-- Instagram -->
                    <LinearLayout
                        android:id="@+id/optPlatformInstagram"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/platform_item_selected"
                        android:paddingHorizontal="10dp"
                        android:layout_marginEnd="8dp">

                        <FrameLayout
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/circle_icon_white_bg">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_instagram"
                                android:contentDescription="Instagram" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvLabelInstagram"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Instagram"
                            android:textColor="@color/accent"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <!-- Facebook -->
                    <LinearLayout
                        android:id="@+id/optPlatformFacebook"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/platform_item_unselected"
                        android:paddingHorizontal="10dp"
                        android:layout_marginEnd="8dp">

                        <FrameLayout
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/circle_icon_white_bg">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_facebook"
                                android:contentDescription="Facebook" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvLabelFacebook"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Facebook"
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <!-- TikTok -->
                    <LinearLayout
                        android:id="@+id/optPlatformTikTok"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/platform_item_unselected"
                        android:paddingHorizontal="10dp"
                        android:layout_marginEnd="8dp">

                        <FrameLayout
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/circle_icon_white_bg">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_tiktok"
                                android:contentDescription="TikTok" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvLabelTikTok"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TikTok"
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <!-- Snapchat -->
                    <LinearLayout
                        android:id="@+id/optPlatformSnapchat"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/platform_item_unselected"
                        android:paddingHorizontal="10dp"
                        android:layout_marginEnd="8dp">

                        <FrameLayout
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/circle_icon_white_bg">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_snapchat"
                                android:contentDescription="Snapchat" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvLabelSnapchat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Snapchat"
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <!-- YouTube -->
                    <LinearLayout
                        android:id="@+id/optPlatformYouTube"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/platform_item_unselected"
                        android:paddingHorizontal="10dp"
                        android:layout_marginEnd="8dp">

                        <FrameLayout
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/circle_icon_white_bg">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_youtube"
                                android:contentDescription="YouTube" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvLabelYouTube"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="YouTube"
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <!-- LinkedIn -->
                    <LinearLayout
                        android:id="@+id/optPlatformLinkedIn"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/platform_item_unselected"
                        android:paddingHorizontal="10dp"
                        android:layout_marginEnd="8dp">

                        <FrameLayout
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/circle_icon_white_bg">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_linkedin"
                                android:contentDescription="LinkedIn" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvLabelLinkedIn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LinkedIn"
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <!-- Twitter / X -->
                    <LinearLayout
                        android:id="@+id/optPlatformTwitter"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/platform_item_unselected"
                        android:paddingHorizontal="10dp"
                        android:layout_marginEnd="8dp">

                        <FrameLayout
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/circle_icon_white_bg">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_twitter_x"
                                android:contentDescription="X" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvLabelTwitter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="X (Twitter)"
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <!-- Discord -->
                    <LinearLayout
                        android:id="@+id/optPlatformDiscord"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/platform_item_unselected"
                        android:paddingHorizontal="10dp"
                        android:layout_marginEnd="8dp">

                        <FrameLayout
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/circle_icon_white_bg">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_discord"
                                android:contentDescription="Discord" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvLabelDiscord"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Discord"
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <!-- GitHub -->
                    <LinearLayout
                        android:id="@+id/optPlatformGitHub"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/platform_item_unselected"
                        android:paddingHorizontal="10dp"
                        android:layout_marginEnd="8dp">

                        <FrameLayout
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/circle_icon_white_bg">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_github"
                                android:contentDescription="GitHub" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvLabelGitHub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GitHub"
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <!-- Spotify -->
                    <LinearLayout
                        android:id="@+id/optPlatformSpotify"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/platform_item_unselected"
                        android:paddingHorizontal="10dp"
                        android:layout_marginEnd="8dp">

                        <FrameLayout
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/circle_icon_white_bg">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_spotify"
                                android:contentDescription="Spotify" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvLabelSpotify"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Spotify"
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <!-- Custom / Web -->
                    <LinearLayout
                        android:id="@+id/optPlatformWeb"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/platform_item_unselected"
                        android:paddingHorizontal="10dp">

                        <FrameLayout
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/circle_icon_white_bg">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_globe"
                                android:contentDescription="WWW" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvLabelWeb"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Strona WWW"
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>


                <!-- Input 1: Name with Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ETYKIETA / NAZWA PROFILU"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etNewQrName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="np. Instagram @twoj_nick lub Mój Sklep"
                android:inputType="textCapWords"
                android:background="@drawable/search_bar_bg"
                android:paddingHorizontal="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="14dp" />

            <!-- Input 2: URL with Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NICK LUB LINK PROFILU"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etNewQrUrl"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="np. @twoj_nick lub link..."
                android:inputType="textUri"
                android:background="@drawable/search_bar_bg"
                android:paddingHorizontal="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="14dp" />

            <!-- QR Code Color Selector (All Unlocked) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="KOLOR KODU QR"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/badgeColorPro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="18dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Obsidian (#0F172A) - Free default -->
                    <FrameLayout
                        android:id="@+id/btnColorObsidian"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/qr_color_ring_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="10dp">
                        <View
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:background="@drawable/dot_color_obsidian" />
                    </FrameLayout>

                    <!-- Royal Blue (#2563EB) -->
                    <FrameLayout
                        android:id="@+id/btnColorBlue"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/qr_color_ring_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="10dp">
                        <View
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:background="@drawable/dot_color_blue" />
                    </FrameLayout>

                    <!-- Luxury Gold (#D97706) -->
                    <FrameLayout
                        android:id="@+id/btnColorGold"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/qr_color_ring_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="10dp">
                        <View
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:background="@drawable/dot_color_gold" />
                    </FrameLayout>

                    <!-- Emerald Green (#059669) -->
                    <FrameLayout
                        android:id="@+id/btnColorEmerald"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/qr_color_ring_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="10dp">
                        <View
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:background="@drawable/dot_color_emerald" />
                    </FrameLayout>

                    <!-- Cyber Violet (#7C3AED) -->
                    <FrameLayout
                        android:id="@+id/btnColorViolet"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/qr_color_ring_unselected"
                        android:clickable="true"
                        android:focusable="true">
                        <View
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:background="@drawable/dot_color_violet" />
                    </FrameLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Create Button -->
            <Button
                android:id="@+id/btnCreateNewQr"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="✨ Wygeneruj i zapisz kod QR"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/btn_pill_dark"
                android:textColor="@color/white" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
