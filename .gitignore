*.iml
.gradle
/local.properties
/.idea/
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties

# Artefakty budowania w katalogu głównym
*.apk
*.idsig

# Wyjątek: oficjalny build wersji release ma być dostępny do pobrania z repozytorium
# (linkuje do niego README). Buildy debug i testowe nadal są pomijane.
!app-release.apk

# Klucze podpisywania - trzymaj je POZA repozytorium (backup offline!).
# Wyciek release.keystore = ktoś może podpisywać się jako Twoja aplikacja.
*.keystore
*.jks

# Załączniki/prywatne pliki robocze (zdjęcia, zrzuty z czatu)
/attachments

# Katalogi build/ wszystkich modułów (core/, data/, feature-*/, app/)
build/
